{
  "description": {
    "es": ["Convierte todas las palabras en palabras pronunciadas únicamente con la `i`."],
    "en": ["Converts every Spanish word into the same word pronounced only using the letter `i`."]
  },
  "groups": {
    "vocal_átona": ["a", "e", "i", "o"],
    "vocal_tónica": ["á", "é", "í", "ó"],
    "aou_átona": ["a", "o", "u"],
    "aou_tónica": ["á", "ó", "ú"],
    "aou": ["<aou_átona>", "<aou_tónica>"],
    "cons": ["b", "c", "d", "f", "g", "h", "j", "k", "l", "m", "n", "ñ", "p", "q", "r", "s", "t", "v", "w", "x", "y", "z"],
    "gq": ["g", "q"],
    "cons_normal": ["<cons>", "!<gq>"],
    "no_ei": ["<cons>", "<aou>"]
  },
  "rules": {
    "vocal→i": {
      "<vocal_átona>": "<>i",
      "<vocal_tónica>": "<>í",
      "gü": "gui",
      "<cons_normal>u": "<cons_normal>i",
      "<cons_normal>ú": "<cons_normal>í"
    },
    "c": {
      "c<aou_átona>": "qui<>",
      "c<aou_tónica>": "quí<>"
    },
    "g": {
      "ga|go|gue": "gui",
      "gá|gó|gué": "guí",
      "gu<no_ei>": "gui<no_ei>"
    },
    "z": {
      "z<aou_átona>": "ci<>",
      "z<aou_tónica>": "cí<>"
    }
  },
  "order": ["c", "g", "z", "vocal→i"]
}
